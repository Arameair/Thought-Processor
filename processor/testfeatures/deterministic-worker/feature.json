{
  "schema": "thought.feature-manifest/1",
  "feature_id": "p1-deterministic-worker",
  "name": "P1 Deterministic Worker (TEST FIXTURE)",
  "version": "0.1.0",
  "description": "Clearly labelled trusted local test feature for the P1 contract. Deterministic text transform; no AI provider; no external calls. NOT Fast AI Worker.",
