{
  "schema": "thought.feature-manifest/1",
  "feature_id": "developer-utility",
  "name": "Developer Utility (developer entrance)",
  "version": "0.1.0",
  "description": "The secure Developer entrance into the Brain system. One read-only capability (developer.connection.check). No shell, no file access, no other services. Admitted only by its exact pinned digest plus the Admin's approval in Identity.",
  "publisher": {
    "name": "Arameair (Thought Processor)",
    "proof": "none (claim only)"
  },
  "source": {
    "repo": "Arameair/Thought-Processor",
    "path": "processor/developer-utility"
  },
  "trust_class": "TRUSTED_LOCAL_TEST_FIXTURE",
  "api": "thought.feature-api/1",
  "runtime": {
    "command": [
      "python3",
      "-I",
      "{package}/utility_agent.py"
    ],
    "requires": [
      "python3 (3.8 or newer) on PATH"
    ],
    "startup_modes": [
      "manual"
    ],
    "default_startup": "manual",
    "default_idle_seconds": 30,
    "recovery": "manual"
  },
  "capabilities": [
    {
      "id": "developer.connection.check",
      "description": "Read-only report of the Developer entrance: Processor link, Identity link (signed, fresh), grants it holds, who asked. Input: leave empty.",
      "data_class": "DEVELOPER_STATUS",
      "requires_grant": true
    }
  ],
  "standalone": {
    "health": true,
    "self_test": true
  },
  "information_sources": [],
  "files": [
    {
      "path": "utility_agent.py",
      "sha256": "888773b54009bec986235d50d0795b72e42f856235cde620f94cfc5970a38bc8"
    }
  ]
}
